-- العثور على جزء من العنصر
local function findPart(obj)
    if obj:IsA("BasePart") then
        return obj
    elseif obj:IsA("Model") then
        return obj.PrimaryPart
            or obj:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

-- تحديد البيضة والانتقال إليها
local function selectEgg(obj)
    local part = findPart(obj)
    if not part or not part:IsDescendantOf(workspace) then
        return
    end

    local oldHighlight = gui:FindFirstChild("EggHighlight")
    if oldHighlight then
        oldHighlight:Destroy()
    end

    local highlight = Instance.new("Highlight")
    highlight.Name = "EggHighlight"
    highlight.Adornee = obj
    highlight.FillColor = Color3.fromRGB(0, 255, 90)
    highlight.OutlineColor = Color3.new(1, 1, 1)
    highlight.FillTransparency = 0.4
    highlight.Parent = gui

    local character = player.Character
    if character then
        character:PivotTo(
            CFrame.new(part.Position + Vector3.new(0, 5, 0))
        )
    end
end

-- مسح النتائج القديمة
local function clearResults()
    for _, child in ipairs(results:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
end

-- البحث عن العناصر المطابقة
local searchVersion = 0

local function updateSearch()
    searchVersion += 1
    local thisSearch = searchVersion
    local query = string.lower(search.Text)

    clearResults()

    if query == "" then
        return
    end

    task.spawn(function()
        local count = 0
        local checked = 0

        for _, obj in ipairs(workspace:GetDescendants()) do
            if thisSearch ~= searchVersion then
                return
            end

            checked += 1

            local name = string.lower(obj.Name)
            local isEgg = name:find("egg", 1, true)
                or name:find("بيض", 1, true)

            if isEgg and name:find(query, 1, true)
                and findPart(obj) then

                count += 1

                local button = Instance.new("TextButton")
                button.Name = "EggResult"
                button.Size = UDim2.new(1, -4, 0, 40)
                button.BackgroundColor3 = Color3.fromRGB(45, 105, 65)
                button.TextColor3 = Color3.new(1, 1, 1)
                button.TextSize = 15
                button.Font = Enum.Font.Gotham
                button.Text = "🥚  " .. obj.Name
                button.BorderSizePixel = 0
                button.LayoutOrder = count
                button.ZIndex = 12
                button.Parent = results

                Instance.new("UICorner", button).CornerRadius =
                    UDim.new(0, 7)

                button.Activated:Connect(function()
                    selectEgg(obj)
                end)

                if count >= 150 then
                    break
                end
            end

            if checked % 100 == 0 then
                task.wait()
            end
        end
    end)
end

search:GetPropertyChangedSignal("Text"):Connect(updateSearch)

print("Egg Finder Pro loaded successfully")
